# ---- deployment -----------------------------------------------------------
# Public origin, used in emails, canonical URLs, the sitemap and Stripe returns.
PUBLIC_BASE_URL=https://shop.example.com
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- runtime --------------------------------------------------------------
PORT=3000
DATA_DIR=./data
# How many reverse proxies stand in front of the app (affects req.ip used for
# rate limiting and the secure-cookie check). 1 = one proxy (default).
# "true" trusts the immediate connection; use a hop count or IP list in production.
TRUST_PROXY=1

# ---- payments (optional) --------------------------------------------------
# Without a key the site still sells using the offline method configured in
# Settings → Orders & payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=0
# 1 = simulated card payments for demos and tests. Never enable in production.
PAYMENTS_DEMO=0

# ---- email (optional) -----------------------------------------------------
# Resend API key. Without it, messages are recorded as "skipped" in the email
# log and the store keeps working. Customer account registration requires the
# key, because sign-up is confirmed with an emailed link.
RESEND_API_KEY=
# Override the Resend API endpoint (self-hosted, proxied or test installs).
# RESEND_API_URL=https://api.resend.com
EMAIL_FROM="Your Business <orders@example.com>"

# Business identity, branding, modules, catalog and content are configured in
# /setup and /admin — not here. Environment seeds a name on first boot only.
